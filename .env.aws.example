# AWS settings (Learner Lab). Copy to .env.aws on the EC2 instance.
# On EC2 there are NO access keys here: the instance profile (LabRole) provides them.

CS_ENV=aws
AWS_REGION=us-east-1

KAFKA_BOOTSTRAP=localhost:9092

# Real S3 / DynamoDB: endpoints stay empty.
S3_BUCKET=cryptosentinel-CHANGE-ME
S3_ENDPOINT_URL=
DYNAMO_ENDPOINT_URL=
TABLE_PREFIX=cryptosentinel

SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,PEPEUSDT
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://data-api.binance.vision

CRYPTOPANIC_TOKEN=

# bedrock if the lab allows it, otherwise groq
LLM_PROVIDER=bedrock
LLM_MODEL=us.amazon.nova-lite-v1:0
GROQ_API_KEY=

SCORER=sagemaker
NOTIFIER=sns
SNS_TOPIC_ARN=
