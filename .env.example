# Local development settings. Copy to .env.local:  cp .env.example .env.local
# .env.local is ignored by Git: put your keys there, never in this file.

CS_ENV=local
AWS_REGION=us-east-1

# --- Kafka ---
KAFKA_BOOTSTRAP=localhost:9092

# --- S3 (SeaweedFS locally; leave S3_ENDPOINT_URL empty on AWS) ---
S3_BUCKET=cryptosentinel
S3_ENDPOINT_URL=http://localhost:8333

# --- DynamoDB (DynamoDB Local; leave empty on AWS) ---
DYNAMO_ENDPOINT_URL=http://localhost:8000
TABLE_PREFIX=cryptosentinel

# Dummy credentials used ONLY for the local S3/DynamoDB emulators.
LOCAL_AWS_ACCESS_KEY_ID=local
LOCAL_AWS_SECRET_ACCESS_KEY=local

# --- Market data ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,PEPEUSDT
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://data-api.binance.vision

# --- News ---
# RSS feeds as name|url pairs (defaults: CoinDesk, Cointelegraph, Decrypt, The Block). Leave commented to use defaults.
# NEWS_FEEDS=coindesk|https://www.coindesk.com/arc/outboundfeeds/rss/?outputType=xml,cointelegraph|https://cointelegraph.com/rss
NEWS_POLL_SECONDS=120
# Clock correction for the historical news dataset, in minutes (0 unless `make newstime` says otherwise)
NEWS_TIME_SHIFT_MINUTES=0
# Optional: free CryptoPanic token, if the free plan still exists. Leave empty to use RSS only.
CRYPTOPANIC_TOKEN=

# --- LLM (agent) ---
# LLM_PROVIDER: groq | ollama | bedrock
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Models ---
# SCORER: local | sagemaker
SCORER=local

# --- Notifications ---
# NOTIFIER: console | sns
NOTIFIER=console
SNS_TOPIC_ARN=
